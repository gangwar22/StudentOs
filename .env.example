PORT=5001
# MongoDB Connection String (Atlas URI or local instance)
# For Atlas, use a database user, URL-encode reserved password characters, and use authSource=admin if the URI has a database path.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Learning_Data?retryWrites=true&w=majority

# JWT Authentication Secret (Set a private, random string of at least 32 characters in production)
JWT_SECRET=replace-this-with-a-private-random-secret-before-production

# Initial Super Admin Email(s) - comma separated
SUPER_ADMIN_EMAILS=super-admin@example.com

# NVIDIA Voice AI Configuration (End-of-Day Voice Reflection & Conceptual Cross-Questioning)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_REQUEST_TIMEOUT_MS=30000

# Google Gemini API Configuration (Dynamic Assessment & Quiz Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# HuggingFace Novita AI Configuration (AI Engineering Mentor)
HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V3.2-Exp:novita

# SMTP Email Configuration (Optional - for sending account verification codes)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=StudentOS <no-reply@example.com>
